# Cloudflare Pages: caching for the files it serves directly (see HOSTING.md; pages get theirs
# from _worker.js).
# The build's own files at the top of /assets carry a hash of their content in their name, so a
# browser can keep them: a new build has new names. (The pictures in /assets/<folder>/ keep
# Pages' default: checked each time.)
/assets/:file
  Cache-Control: public, max-age=31536000, immutable

# The service worker: always checked, so a new version takes over.
/sw.js
  Cache-Control: no-cache

# Live updates for Sellio's apps (scripts/app-update.mjs, src/lib/liveUpdates.js): the manifest is
# always checked again, and the apps' pages (https://localhost, capacitor://localhost) may read it.
# The zips keep Pages' default; an app downloads each version once.
/app-updates/manifest.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
