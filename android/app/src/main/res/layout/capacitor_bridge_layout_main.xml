<?xml version="1.0" encoding="utf-8"?>
<!-- The app's screen (Capacitor's BridgeActivity), as in Capacitor's own layout of this name,
     which this replaces, with Android's own pull to refresh (SellioRefreshLayout) around the
     web view. Capacitor finds the web view by its id, webview. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity">

    <com.base6985959ce9aaceadb8b7cc41.app.SellioRefreshLayout
        android:id="@+id/sellio_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.getcapacitor.CapacitorWebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.base6985959ce9aaceadb8b7cc41.app.SellioRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
