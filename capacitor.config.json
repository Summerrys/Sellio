{
  "appId": "com.base6985959ce9aaceadb8b7cc41.app",
  "appName": "Sellio",
  "webDir": "dist-app",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#ffffff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "LIGHT"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "channelUrl": "",
      "statsUrl": "",
      "appReadyTimeout": 15000,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "keepUrlPathAfterReload": true
    }
  }
}
